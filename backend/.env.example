# Copy to .env, fill in locally, then run ./run.sh. Never commit .env.
# Generate a private token with: openssl rand -hex 24
AGENT_TOKEN=
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=
AGENT_BIND_ADDRESS=127.0.0.1
AGENT_PORT=8080
# Optional, relative to the backend directory:
# AGENT_DB_URL=jdbc:h2:file:./data/memory-agent
# AGENT_DB_PASSWORD=
